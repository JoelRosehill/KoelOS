#!/bin/bash
# koel — the KoelOS build tool. One CLI to build, run, and test both the
# 64-bit and 32-bit kernels, for the floppy and hard-disk targets.
#
#   ./koel build  [--arch 32|64] [--target floppy|metal|all]
#   ./koel run    [--arch 32|64] [--target floppy|metal] [--cpu MODEL]
#                 [--no-build] [--gdb] [--headless]
#   ./koel test   [--arch 32|64] [--target floppy|metal|all]
#   ./koel clean
#   ./koel help
#
# 64-bit kernel requires a long-mode CPU. 32-bit kernel runs on anything 386+
# (so `run`/`test --arch 32` default to an emulated 32-bit CPU to prove it).
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
QEMU="qemu-system-x86_64"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
info()  { echo -e "${BLUE}[koel]${NC} $1"; }
ok()    { echo -e "${GREEN}[ok]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
die()   { echo -e "${RED}[error]${NC} $1" >&2; exit 1; }

FLOPPY_SECTORS=2880          # 1.44 MB
METAL_MB=64

usage() {
    cat <<'EOF'
koel — the KoelOS build tool

Usage:
  ./koel build [options]      Build disk image(s)
  ./koel run   [options]      Build (unless --no-build) and boot in QEMU
  ./koel test  [options]      Headless boot smoke test (asserts the shell prompt)
  ./koel clean                Remove dist/ build artifacts
  ./koel list                 Show the build matrix
  ./koel help                 This help

Options:
  --arch 32|64                CPU width of the kernel        (default: 64)
  --target floppy|metal|all   Disk image to produce/boot     (default: floppy)
  --cpu MODEL                  QEMU -cpu model (run/test)
                              (default: 64-bit=qemu64, 32-bit=pentium3)
  --no-build                  run: boot the existing image without rebuilding
  --gdb                       run: pause at reset, gdb stub on :1234
  --headless                  run: no window, console only on serial

Examples:
  ./koel build --arch 32 --target floppy   # the 1.44 MB image for a 32-bit board
  ./koel run   --arch 32                    # boot it on an emulated 32-bit CPU
  ./koel run   --arch 64 --target metal     # the full 64-bit OS on a 64-bit CPU
  ./koel test  --arch 32 --target all       # smoke-test both 32-bit images
EOF
}

# ---- paths -----------------------------------------------------------------
img_path() {  # arch target
    case "$1-$2" in
        64-metal)  echo "$ROOT_DIR/dist/metal/koelOS-metal.img" ;;
        64-floppy) echo "$ROOT_DIR/dist/floppy/koelOS-floppy.img" ;;
        32-metal)  echo "$ROOT_DIR/dist/metal32/koelOS32-metal.img" ;;
        32-floppy) echo "$ROOT_DIR/dist/floppy32/koelOS32-floppy.img" ;;
    esac
}

# ---- building --------------------------------------------------------------
build_one() {  # arch target
    local arch="$1" target="$2"
    if [ "$arch" = "64" ]; then
        case "$target" in
            metal)  bash "$ROOT_DIR/build_metal.sh" >/dev/null ;;
            floppy) bash "$ROOT_DIR/build_floppy.sh" >/dev/null ;;
        esac
        ok "built 64-bit $target -> $(img_path 64 "$target")"
        return
    fi

    # --- 32-bit native build ---
    local outdir kbin bootsrc bootbin img
    img="$(img_path 32 "$target")"
    outdir="$(dirname "$img")"
    mkdir -p "$outdir"
    kbin="$outdir/kernel32.bin"
    bootbin="$outdir/boot32.bin"
    case "$target" in
        floppy) bootsrc="$ROOT_DIR/boot_floppy32.asm" ;;
        metal)  bootsrc="$ROOT_DIR/boot_metal32.asm" ;;
    esac

    nasm -f bin "$ROOT_DIR/kernel32.asm" -o "$kbin" || die "kernel32 failed to assemble"
    local ksize ksectors
    ksize=$(wc -c < "$kbin")
    ksectors=$(((ksize + 511) / 512))
    [ "$ksectors" -gt 127 ] && die "kernel32 needs $ksectors sectors (>127); grow the boot load window"

    nasm -f bin "$bootsrc" -o "$bootbin" -d KERNEL_SECTORS="$ksectors" || die "boot sector failed to assemble"
    [ "$(wc -c < "$bootbin")" -ne 512 ] && die "$(basename "$bootsrc") boot sector is not 512 bytes"

    if [ "$target" = "floppy" ]; then
        [ "$((1 + ksectors))" -gt "$FLOPPY_SECTORS" ] && die "boot+kernel exceed a floppy"
        dd if=/dev/zero of="$img" bs=512 count="$FLOPPY_SECTORS" status=none
    else
        dd if=/dev/zero of="$img" bs=1m count="$METAL_MB" status=none
    fi
    dd if="$bootbin" of="$img" conv=notrunc bs=512 count=1 status=none
    dd if="$kbin"    of="$img" conv=notrunc bs=512 seek=1 status=none
    ok "built 32-bit $target ($ksize byte kernel, $ksectors sectors) -> $img"
}

build_targets() {  # arch target(all|floppy|metal)
    if [ "$2" = "all" ]; then
        build_one "$1" floppy
        build_one "$1" metal
    else
        build_one "$1" "$2"
    fi
}

# ---- qemu ------------------------------------------------------------------
# Sets the global DRIVE_ARGS array (an array keeps paths with spaces intact).
set_drive_args() {  # arch target
    local img; img="$(img_path "$1" "$2")"
    if [ "$2" = "floppy" ]; then
        DRIVE_ARGS=(-drive "file=$img,if=floppy,format=raw" -boot a)
    else
        DRIVE_ARGS=(-drive "format=raw,file=$img,if=ide")
    fi
}

default_cpu() { [ "$1" = "32" ] && echo "pentium3" || echo "qemu64"; }

# ---- subcommands -----------------------------------------------------------
cmd_run() {
    local arch="$1" target="$2" cpu="$3" build="$4" gdb="$5" headless="$6"
    [ "$target" = "all" ] && die "run needs a single --target (floppy or metal)"
    [ "$build" = "1" ] && build_targets "$arch" "$target"
    local img; img="$(img_path "$arch" "$target")"
    [ -f "$img" ] || die "image not found: $img (drop --no-build)"
    [ -z "$cpu" ] && cpu="$(default_cpu "$arch")"

    set_drive_args "$arch" "$target"
    local -a args=(-m 256M -cpu "$cpu" "${DRIVE_ARGS[@]}" -serial stdio -no-reboot)
    [ "$headless" = "1" ] && args+=(-display none)
    [ "$gdb" = "1" ] && args+=(-s -S)

    info "booting ${arch}-bit $target on -cpu $cpu (Ctrl-A X to quit serial)"
    exec "$QEMU" "${args[@]}"
}

cmd_test() {
    local arch="$1" target="$2" cpu="$3"
    [ -z "$cpu" ] && cpu="$(default_cpu "$arch")"
    local list="$target" rc=0
    [ "$target" = "all" ] && list="floppy metal"
    for t in $list; do
        build_targets "$arch" "$t"
        smoke_one "$arch" "$t" "$cpu" || rc=1
    done
    return $rc
}

smoke_one() {  # arch target cpu
    local arch="$1" target="$2" cpu="$3"
    local img; img="$(img_path "$arch" "$target")"
    local log; log="$(mktemp)"
    info "smoke: ${arch}-bit $target on -cpu $cpu"
    set_drive_args "$arch" "$target"
    "$QEMU" -m 256M -cpu "$cpu" "${DRIVE_ARGS[@]}" \
        -display none -monitor none -serial file:"$log" -no-reboot &
    local pid=$! i=0
    while [ "$i" -lt 40 ]; do
        grep -q "root@koelos" "$log" 2>/dev/null && break
        sleep 0.5; i=$((i + 1))
    done
    kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
    if grep -q "root@koelos" "$log" && grep -q "KoelOS" "$log"; then
        ok "${arch}-bit $target booted to shell"
        rm -f "$log"; return 0
    fi
    warn "serial captured:"; cat "$log"; rm -f "$log"
    echo -e "${RED}[fail]${NC} ${arch}-bit $target did not reach the shell" >&2
    return 1
}

cmd_clean() {
    rm -rf "$ROOT_DIR/dist/metal32" "$ROOT_DIR/dist/floppy32"
    rm -f "$ROOT_DIR"/dist/metal/*.bin "$ROOT_DIR"/dist/metal/*.img 2>/dev/null || true
    rm -f "$ROOT_DIR"/dist/floppy/*.bin "$ROOT_DIR"/dist/floppy/*.img 2>/dev/null || true
    ok "cleaned dist/ build artifacts"
}

cmd_list() {
    echo -e "${BOLD}KoelOS build matrix${NC}"
    echo "  arch  target  image"
    echo "  ----  ------  -----------------------------------"
    echo "  64    floppy  dist/floppy/koelOS-floppy.img   (full OS, needs 64-bit CPU)"
    echo "  64    metal   dist/metal/koelOS-metal.img     (full OS, needs 64-bit CPU)"
    echo "  32    floppy  dist/floppy32/koelOS32-floppy.img (lite shell, any 386+)"
    echo "  32    metal   dist/metal32/koelOS32-metal.img   (lite shell, any 386+)"
}

# ---- arg parsing -----------------------------------------------------------
ARCH=64; TARGET=floppy; CPU=""; BUILD=1; GDB=0; HEADLESS=0
SUB="${1:-help}"; shift || true
while [ $# -gt 0 ]; do
    case "$1" in
        --arch)     ARCH="$2"; shift ;;
        --target)   TARGET="$2"; shift ;;
        --cpu)      CPU="$2"; shift ;;
        --no-build) BUILD=0 ;;
        --gdb)      GDB=1 ;;
        --headless) HEADLESS=1 ;;
        -h|--help)  usage; exit 0 ;;
        *)          die "unknown option: $1" ;;
    esac
    shift
done
case "$ARCH" in 32|64) ;; *) die "--arch must be 32 or 64" ;; esac
case "$TARGET" in floppy|metal|all) ;; *) die "--target must be floppy, metal, or all" ;; esac
if [ "$SUB" = "run" ] || [ "$SUB" = "test" ]; then
    command -v "$QEMU" >/dev/null 2>&1 || die "$QEMU not found in PATH"
fi

case "$SUB" in
    build) build_targets "$ARCH" "$TARGET" ;;
    run)   cmd_run "$ARCH" "$TARGET" "$CPU" "$BUILD" "$GDB" "$HEADLESS" ;;
    test)  cmd_test "$ARCH" "$TARGET" "$CPU" ;;
    clean) cmd_clean ;;
    list)  cmd_list ;;
    help|-h|--help) usage ;;
    *)     die "unknown command: $SUB (try ./koel help)" ;;
esac
